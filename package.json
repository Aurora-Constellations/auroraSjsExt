{
	"name": "aurora-sjs-ext",
	"displayName": "auroraSjsExt",
	"description": "",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.90.0"
	},
	"publisher": "axiommd",
	"categories": [
		"Other"
	],
	"private": true,
	"workspaces": [
		"axiombilling",
		"axiompatienttracker",
		"pcmalgebra",
		"d3example"
	],
	"main": "./out/extension",
	"scripts": {
		"build": "lerna run build",
		"watch": "lerna run dev --parallel"
	},
	"contributes": {
		"languages": [
			{
				"id": "aurora",
				"aliases": [
					"Aurora",
					"aurora"
				],
				"extensions": [
					".aurora"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "aurora",
				"scopeName": "source.aurora",
				"path": "syntaxes/aurora.tmLanguage.json"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "aurora-container",
					"title": "Aurora",
					"icon": "$(symbol-structure)"
				}
			]
		},
		"views": {
			"aurora-container": [
				{
					"id": "aurora.patients",
					"name": "Patients",
					"icon": "$(person)",
					"initialSize": 1,
					"when": "config.aurora.presentationMode"
				},
				{
					"id": "aurora",
					"type": "webview",
					"name": "Patient Care Scenario",
					"icon": "$(symbol-structure)",
					"initialSize": 3
				}
			]
		},
		"commands": [
			{
				"command": "AuroraSjsExt.aurora",
				"title": "Hello Aurora"
			},
			{
				"command": "AuroraSjsExt.patients",
				"title": "Patient Tracker"
			},
			{
				"command": "AuroraSjsExt.billing",
				"title": "Billing"
			},
			{
				"command": "AuroraSjsExt.processDSL",
				"title": "Merge PCMs"
			},
			{
				"command": "AuroraSjsExt.toggleDiagramLayout",
				"title": "Toggle Diagram Layout",
				"icon": "$(type-hierarchy)"
			},
			{
				"command": "AuroraSjsExt.changeNarrativeType",
				"title": "Change Narrative Type"
			},
			{
				"command": "AuroraSjsExt.hideNarratives",
				"title": "Hide Narratives"
			},
			{
				"command": "AuroraSjsExt.showNarratives",
				"title": "Show Narratives"
			},
			{
				"command": "AuroraSjsExt.hideNamedGroups",
				"title": "Hide Named Groups"
			},
			{
				"command": "AuroraSjsExt.mcp",
				"title": "Aurora MCP"
			},
			{
				"command": "AuroraSjsExt.startRecording",
				"title": "Aurora Start Recording",
				"icon": "$(record)"
			},
			{
				"command": "AuroraSjsExt.stopRecording",
				"title": "Aurora Stop Recording",
				"icon": "$(debug-stop)"
			},
			{
				"command": "AuroraSjsExt.transcribeRecording",
				"title": "Aurora Transcribe Recording"
			},
			{
				"command": "AuroraSjsExt.transcribeAndRunMcp",
				"title": "Aurora Transcribe and Run MCP"
			},
			{
				"command": "AuroraSjsExt.newPatient",
				"title": "New Patient",
				"category": "Aurora",
				"icon": "$(add)"
			},
			{
				"command": "AuroraSjsExt.refreshPatients",
				"title": "Refresh Patients",
				"category": "Aurora",
				"icon": "$(refresh)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "AuroraSjsExt.patients",
					"when": "resourceExtname == .aurora",
					"group": "navigation@1"
				}
			],
			"view/title": [
				{
					"command": "AuroraSjsExt.newPatient",
					"when": "view == aurora.patients",
					"group": "navigation@1"
				},
				{
					"command": "AuroraSjsExt.refreshPatients",
					"when": "view == aurora.patients",
					"group": "navigation@2"
				},
				{
					"command": "AuroraSjsExt.startRecording",
					"when": "view == aurora && config.aurora.presentationMode && !aurora.recording",
					"group": "navigation@1"
				},
				{
					"command": "AuroraSjsExt.stopRecording",
					"when": "view == aurora && config.aurora.presentationMode && aurora.recording",
					"group": "navigation@1"
				},
				{
					"command": "AuroraSjsExt.toggleDiagramLayout",
					"when": "view == aurora && config.aurora.presentationMode",
					"group": "navigation@2"
				},
				{
					"command": "AuroraSjsExt.processDSL",
					"when": "view == aurora",
					"group": "secondary"
				},
				{
					"command": "AuroraSjsExt.toggleDiagramLayout",
					"when": "view == aurora && !config.aurora.presentationMode",
					"group": "secondary"
				},
				{
					"command": "AuroraSjsExt.changeNarrativeType",
					"when": "view == aurora",
					"group": "secondary"
				},
				{
					"command": "AuroraSjsExt.hideNarratives",
					"when": "view == aurora && !aurora.narrativesHidden",
					"group": "secondary"
				},
				{
					"command": "AuroraSjsExt.showNarratives",
					"when": "view == aurora && aurora.narrativesHidden",
					"group": "secondary"
				},
				{
					"command": "AuroraSjsExt.hideNamedGroups",
					"when": "view == aurora && !config.aurora.presentationMode",
					"group": "secondary"
				}
			],
			"commandPalette": [
				{
					"command": "AuroraSjsExt.newPatient",
					"when": "config.aurora.presentationMode"
				},
				{
					"command": "AuroraSjsExt.refreshPatients",
					"when": "config.aurora.presentationMode"
				},
				{
					"command": "AuroraSjsExt.hideNarratives",
					"when": "!aurora.narrativesHidden"
				},
				{
					"command": "AuroraSjsExt.showNarratives",
					"when": "aurora.narrativesHidden"
				}
			]
		},
		"configuration": {
			"title": "Aurora",
			"properties": {
				"aurora.presentationMode": {
					"type": "boolean",
					"default": false,
					"description": "Start in the end-user layout: reveal the Patients and Care Scenario views on startup and keep developer panels, such as the extension's output, closed. Enabled by the profile that `sbt openUI` launches."
				}
			}
		}
	},
	"devDependencies": {
		"@scala-js/vite-plugin-scalajs": "^1.0.0",
		"@types/d3": "^7.4.3",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.94.0",
		"@types/vscode-webview": "^1.57.0",
		"langium": "^4.3.1",
		"lerna": "^8.2.3",
		"typescript": "^5.6.3",
		"vite": "^4.1.0"
	},
	"dependencies": {
		"aurora-langium": "0.4.3",
		"d3": "^7.9.0",
		"elkjs": "^0.11.1",
		"fs-extra": "^11.3.1"
	},
	"overrides": {
		"@types/d3-selection": "3.0.3",
		"@types/d3-transition": "3.0.2",
		"@types/d3-dispatch": "3.0.1",
		"@types/d3-drag": "3.0.1",
		"@types/d3-zoom": "3.0.1",
		"@types/d3-brush": "3.0.1",
		"@types/d3-force": "3.0.3"
	}
}
